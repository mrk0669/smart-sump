# Copy this file to .env and fill it in. .env is git-ignored: never commit real secrets.

# MQTT broker login (Mosquitto password auth). Used by the simulator/ESP32,
# the logger and the dashboard.
MQTT_USERNAME=smartsump
MQTT_PASSWORD=change-me

# Telegram alerts (optional). Leave empty and alerts are skipped quietly.
# Create a bot with @BotFather to get the token; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
